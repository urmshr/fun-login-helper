{
  "manifest_version": 3,
  "name": "FUN Login Helper",
  "version": "1.0.0",
  "description": "公立はこだて未来大学の SSO へのログインまでの画面操作を補助します（非公式）",
  "permissions": ["storage"],
  "action": {
    "default_title": "FUN Login Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://hope.fun.ac.jp/*", "https://sso.fun.ac.jp/my.policy*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
